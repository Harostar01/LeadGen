# ==========================================
# LeadPulse AI - Environment Configuration
# ==========================================

# 1. Supabase PostgreSQL Connection URL (via Prisma)
# Get your free database at https://supabase.com
# Example format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres"

# Direct URL for Prisma migrations (optional for Supabase connection pooler)
# DIRECT_URL="postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres"

# 2. Groq AI Cloud API Key (Free tier with ultra-fast Llama-3.1-8b-instant inference)
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"

# 3. Upstash Redis (Free Serverless Redis for Rate Limiting, Deduplication & Caching)
# Get your free instance at https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token_here"

# 4. Optional QStash / Cron Secret
# Protects /api/cron/fetch-rss from unauthorized triggers
CRON_SECRET="your_optional_secure_cron_secret"

# 5. Base App URL (used for CORS and extension communication)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
